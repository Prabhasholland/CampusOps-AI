# Baked in at build time by Vite (import.meta.env.VITE_API_URL is inlined
# during `npm run build`, not read at runtime) - changing this after a
# Netlify deploy requires a rebuild, not just an env var change.
#
# Leave unset for local dev: Vite's dev server proxies /api to
# localhost:8000 (see vite.config.js), so nothing needs configuring to run
# this locally. Set it to your Render backend's URL for a Netlify build.
VITE_API_URL=
