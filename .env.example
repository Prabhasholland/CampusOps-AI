# Leave both unset to run against the local mock CALL-E transport (the default
# while onboarding is pending). Set CALLE_API_KEY once a real key is issued.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Powers prepare_call()'s reasoning step (app/prepare.py), via Google AI
# Studio. Leave unset to run on DeterministicPreparer (keyword classifier +
# single-pass TF-IDF) instead - prepare_call() falls back to it automatically
# on any API error, timeout, or exhausted retry, so this is optional, not
# required for the app to run.
GEMINI_API_KEY=
